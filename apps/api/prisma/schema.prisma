/// Opt-in write dedupe for leave-first / client retries.
/// Requests without X-Idempotency-Key are untouched (zero ops impact).
model IdempotencyRecord {
  id             String   @id @default(cuid())
  /// Usually authenticated userId; "system" when unauthenticated.
  scope          String
  key            String
  method         String
  path           String
  requestHash    String
  /// processing | completed
  status         String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime

  @@unique([scope, key])
  @@index([expiresAt])
  @@index([status, updatedAt])
}

enum StoreOrderStatus {
  pending_payment
  paid
  cancelled
  fulfilled
}

enum StoreFulfillmentType {
  collection
  fitment
  delivery
}

/// Guest checkout from the public parts shop (VISP + VSP catalog).
model StoreOrder {
  id                 String               @id @default(cuid())
  reference          String               @unique
  status             StoreOrderStatus       @default(pending_payment)
  fulfillment        StoreFulfillmentType
  customerName       String
  customerEmail      String
  customerPhone      String
  registration       String?
  notes              String?
  currency           String               @default("NGN")
  subtotal           Decimal
  total              Decimal
  paystackReference  String?              @unique
  paystackAccessCode String?
  paidAt             DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  lines StoreOrderLine[]
  sales StoreOrderSale[]

  @@index([status, createdAt])
}

model StoreOrderLine {
  id        String     @id @default(cuid())
  orderId   String
  order     StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  itemId    String
  sku       String
  name      String
  qty       Int
  unitPrice Decimal
  lineTotal Decimal

  @@index([orderId])
  @@index([tenantId])
  @@index([tenantId, sku])
}

model StoreOrderSale {
  id       String     @id @default(cuid())
  orderId  String
  order    StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  saleId   String
  sale     Sale       @relation(fields: [saleId], references: [id])

  @@unique([orderId, tenantId])
  @@index([saleId])
}

enum CmsPostStatus {
  draft
  published
}

/// Public marketing / tenant-scoped CMS posts (blog articles).
model CmsPost {
  id            String        @id @default(cuid())
  /// "group" for VAG marketing site; tenant cuid for per-entity content.
  scopeKey      String        @default("group")
  tenantId      String?
  tenant        Tenant?       @relation(fields: [tenantId], references: [id])
  slug          String
  title         String
  excerpt       String
  category      String
  coverImageUrl String
  author        String        @default("Vonos Workshop")
  status        CmsPostStatus @default(draft)
  publishedAt   DateTime?
  readMinutes   Int           @default(5)
  intro         Json
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  sections CmsPostSection[]

  @@unique([scopeKey, slug])
  @@index([scopeKey, status, publishedAt])
  @@index([tenantId, status])
}

model CmsPostSection {
  id         String   @id @default(cuid())
  postId     String
  post       CmsPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  sectionId  String
  sortOrder  Int
  title      String
  paragraphs Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([postId, sortOrder])
}
