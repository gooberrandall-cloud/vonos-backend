  expenseDate       DateTime         @default(now())
  createdById       String?
  /// Denormalized display name (mirrors Sale.createdByName) — survives even when
  /// the creator user row is missing (common for migrated expenses).
  createdByName     String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  invoice Invoice?

  @@index([tenantId])
  @@index([categoryId])
  @@index([expenseForCustomerId])
  @@index([contactCustomerId])
  @@index([accountId])
  /// Partial (SQL): Expense_tenantId_expenseDate_id_active_idx
