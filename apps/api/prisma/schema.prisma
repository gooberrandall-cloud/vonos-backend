generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  admin
  manager
  staff
  viewer
}

enum UserStatus {
  invited
  active
  suspended
}

enum AuthTokenType {
  invite
  password_reset
  refresh
}

enum Archetype {
  stock
  transaction
  job
  appointment
}

enum StockStatus {
  in_stock
  low_stock
  out_of_stock
}

enum LedgerEntryType {
  revenue
  cost
  expense
}

enum AccountTxnType {
  debit
  credit
}

enum MovementSource {
  standard
  purchase_return
}

enum MovementType {
  inbound
  outbound
  transfer
}

enum MovementStatus {
  Ordered
  Pending
  Approved
  Received
  Shipped
  Delivered
}

enum PaymentStatus {
  paid
  partial
  due
  overdue
}

enum PurchasePaymentStatus {
  paid
  due
  partial
  overdue
}

enum SaleStatus {
  completed
  refunded
  partially_refunded
  written_off
  draft
  quotation
}

enum InvoiceKind {
  sale
  purchase
  expense
  payroll
  payroll_group
  job_invoice
  job_quote
}

model Tenant {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  archetype Archetype
  config    Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users              User[]
  items              Item[]
  itemLocationStock  ItemLocationStock[]
  jobs               Job[]
  ledgerEntries      LedgerEntry[]
  tenantDailyFinance TenantDailyFinance[]
  tenantEntitySnapshot TenantEntitySnapshot?
  suppliers          Supplier[]
  stockMovements     StockMovement[]
  customers          Customer[]
  sales              Sale[]
  appointments       Appointment[]
  vehicles           Vehicle[]
  requisitions       Requisition[]
  salonServices      SalonService[]
  cafeTables         CafeTable[]
  migrationLegacyIds MigrationLegacyId[]
  auditLogs          AuditLog[]
  paymentAccounts    PaymentAccount[]
  accountTransactions AccountTransaction[]
  payments           Payment[]
  productCategories  ProductCategory[]
  brands             Brand[]
  productUnits       ProductUnit[]
  warranties         Warranty[]
  sellingPriceGroups  SellingPriceGroup[]
  expenses            Expense[]
  expenseCategories   ExpenseCategory[]
  customerGroups      CustomerGroup[]
  payrolls            Payroll[]
  payrollGroups       PayrollGroup[]
  payComponents       PayComponent[]
  designations        Designation[]
  employees           Employee[]
  leaveTypes          LeaveType[]
  leaves              Leave[]
  holidays            Holiday[]
  attendanceShifts    AttendanceShift[]
  attendances         Attendance[]
  salesTargets        SalesTarget[]
  invoiceLayouts      InvoiceLayout[]
  invoiceSchemes      InvoiceScheme[]
  receiptPrinters     ReceiptPrinter[]
  invoices            Invoice[]
  discounts           Discount[]
  variationTemplates  VariationTemplate[]
  tenantRoles         TenantRole[]
  storeOrderLines     StoreOrderLine[]
  storeOrderSales     StoreOrderSale[]
  cmsPosts            CmsPost[]
}

model Appointment {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  stylistName  String
  serviceName  String
  servicePrice Decimal   @default(0)
  currency     String    @default("NGN")
  startTime    DateTime
  endTime      DateTime
  status       String
  notes        String?
  locationCode String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantId, startTime])
  @@index([tenantId, status])
  @@index([tenantId, status, startTime])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  /// Optional login handle (case-insensitive unique when set).
  username     String?    @unique
  passwordHash String
  name         String
  role         Role
  status       UserStatus @default(invited)
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  /// HQ6 / Ultimate POS job role (permission matrix) — optional; JWT `role` remains the coarse capability.
  tenantRoleId String?
  tenantRole   TenantRole? @relation(fields: [tenantRoleId], references: [id])
  tokenVersion Int        @default(0)
  totpSecret   String?
  totpEnabled  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  authTokens   AuthToken[]

  itemsCreated         Item[]          @relation("ItemCreatedBy")
  stockMovementsCreated StockMovement[] @relation("StockMovementCreatedBy")
  suppliersCreated     Supplier[]      @relation("SupplierCreatedBy")
  suppliersAssigned    Supplier[]      @relation("SupplierAssignedTo")
  jobsCreated          Job[]           @relation("JobCreatedBy")
  customersCreated     Customer[]      @relation("CustomerCreatedBy")
  customersAssigned    Customer[]      @relation("CustomerAssignedTo")
  salesCreated         Sale[]          @relation("SaleCreatedBy")
  salesAsCleaner       Sale[]          @relation("SaleCleaner")
  employeesLinked      Employee[]      @relation("EmployeeUser")
  auditLogsActed       AuditLog[]      @relation("AuditLogActor")
  payrollGroupsCreated PayrollGroup[]  @relation("PayrollGroupCreatedBy")

  @@index([tenantId])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@index([tenantRoleId])
}

/// Per-tenant job roles with Ultimate POS–style permission keys (HQ6 Roles page).
model TenantRole {
  id             String    @id @default(cuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  name           String
  permissions    String[]  @default([])
  isServiceStaff Boolean   @default(false)
  /// Admin / system roles cannot be deleted or renamed away from Admin semantics.
  locked         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  users          User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, name])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model Item {
  id                 String      @id @default(cuid())
  tenantId           String
  tenant             Tenant      @relation(fields: [tenantId], references: [id])
  sku                String
  name               String
  category           String?
  subCategory        String?
  description        String?
  barcodeType        String?
  unit               String?
  weight             String?
  /// Free-text car model fitment (e.g. "Camry 2018") — used for part suggestions.
  carModel           String?
  imageUrl           String?
  enableImei         Boolean     @default(false)
  preparationMinutes Int?
  quantity           Int         @default(0)
  binLocation        String?
  locationCode       String?
  reorderPoint       Int?
  costPrice          Decimal
  sellPrice          Decimal?
  currency           String      @default("NGN")
  status             StockStatus @default(in_stock)
  availableForRetail Boolean     @default(false)
  createdByUserId    String?
  createdByUser      User?       @relation("ItemCreatedBy", fields: [createdByUserId], references: [id])
  createdByName      String?
  brandId            String?
  brand              Brand?      @relation(fields: [brandId], references: [id])
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  /// Generated FTS — migration `20260812190000_list_search_tsvector` (do not write via Prisma).
  searchVector       Unsupported("tsvector")? @default(dbgenerated("(((setweight(to_tsvector('simple'::regconfig, COALESCE(name, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, COALESCE(sku, ''::text)), 'A'::\"char\")) || setweight(to_tsvector('simple'::regconfig, COALESCE(\"carModel\", ''::text)), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, COALESCE(category, ''::text)), 'C'::\"char\"))"))

  locationStock      ItemLocationStock[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, availableForRetail])
  @@index([tenantId, brandId])
  @@index([tenantId, carModel])
  @@index([tenantId, category])
  @@index([tenantId, deletedAt])
  /// B-tree for exact / prefix SKU + name lookup (≈ O(log n) with tenant scope).
  @@index([tenantId, sku])
  @@index([tenantId, name])
  /// Partial (SQL): Item_tenantId_updatedAt_id_active_idx
  /// ON ("tenantId", "updatedAt" DESC, id DESC) WHERE "deletedAt" IS NULL
}

/// Per-location quantity for an item (mirrors Ultimate POS variation_location_details).
/// Item.quantity is the derived sum across these rows.
model ItemLocationStock {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  itemId       String
  item         Item     @relation(fields: [itemId], references: [id])
  locationCode String
  binLocation  String   @default("")
  quantity     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([itemId, locationCode, binLocation])
  @@index([tenantId])
  @@index([itemId])
  @@index([tenantId, locationCode])
}

model StockMovement {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  type      MovementType
  reference String
  status    MovementStatus @default(Ordered)
  lines          Json
  /// Denormalized from lines[] — list pages must not expand jsonb.
  itemCount      Int            @default(0)
  /// Denormalized Σ(qty × unitCost) from lines[].
  grandTotal     Decimal        @default(0)
  notes          String?
  locationCode   String?
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])
  source         MovementSource @default(standard)
  paymentStatus  PurchasePaymentStatus?
  /** Cached sum of purchase payments — list pages must not re-sum Payment. */
  totalPaid      Decimal               @default(0)
  paymentMethod  String?
  date            DateTime
  createdByUserId String?
  createdByUser   User?          @relation("StockMovementCreatedBy", fields: [createdByUserId], references: [id])
  createdByName   String?
  createdAt       DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  invoice Invoice?

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, date])
  @@index([tenantId, type, date])
  @@index([tenantId, type, status])
  @@index([tenantId, type, deletedAt])
  @@index([tenantId, type, deletedAt, date])
  @@index([tenantId, source])
  @@index([tenantId, paymentStatus])
  @@index([supplierId])
}

model Supplier {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  locationCode String?
  notes           String?
  /** HQ6 contact tax / VAT registration number. */
  taxNumber       String?
  /** Supplier bank / account details (Ultimate POS contact bank fields). */
  accountHolderName String?
  bankName          String?
  bankBranch        String?
  bankCode          String?
  bankAccountNo     String?
  taxPayerId        String?
  /** HQ6 contact active/inactive — independent of purchase-activity rollup. */
  status          String   @default("active")
  openingBalance  Decimal  @default(0)
  totalPurchase       Decimal  @default(0)
  totalPurchaseDue    Decimal  @default(0)
  totalPurchasePaid   Decimal  @default(0)
  totalPurchaseReturn Decimal  @default(0)
  totalAdvance        Decimal  @default(0)
  lastPurchaseAt      DateTime?
  assignedToUserId String?
  assignedToUser   User?    @relation("SupplierAssignedTo", fields: [assignedToUserId], references: [id])
  createdByUserId String?
  createdByUser   User?    @relation("SupplierCreatedBy", fields: [createdByUserId], references: [id])
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  stockMovements StockMovement[]
  invoices       Invoice[]

  @@index([tenantId])
  @@index([assignedToUserId])
  @@index([tenantId, totalPurchaseDue])
  @@index([tenantId, lastPurchaseAt])
  @@index([tenantId, status])
  /// Partial (SQL): Supplier_tenantId_name_id_active_idx
  /// ON ("tenantId", name, id) WHERE "deletedAt" IS NULL
}

model Job {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  reference        String
  description      String
  status           String
  hasQuote         Boolean   @default(false)
  quoteAmount      Decimal?
  quoteNotes       String?
  quoteValidUntil  DateTime?
  invoiceAmount    Decimal?
  invoiceNotes     String?
  customerId       String?
  customer         Customer? @relation(fields: [customerId], references: [id])
  customerName     String?
  vehicleId        String?
  locationCode     String?
  assignedStaffIds String[]
  dueDate          DateTime?
  qcChecklist      Json?
  qcNotes          String?
  createdByUserId  String?
  createdByUser    User?     @relation("JobCreatedBy", fields: [createdByUserId], references: [id])
  createdByName    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  materials    JobMaterial[]
  labourEntries JobLabour[]
  invoices     Invoice[]
  sales        Sale[]

  @@unique([tenantId, reference])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, updatedAt])
  @@index([tenantId, customerId])
}

model JobMaterial {
  id                 String   @id @default(cuid())
  jobId              String
  job                Job      @relation(fields: [jobId], references: [id])
  itemId             String?
  name               String
  quantity           Decimal
  unitCost           Decimal
  totalCost          Decimal
  source             String?
  sourceType         String?
  sourceDepartment   String?
  supplierId         String?
  supplierName       String?
  purchaseMovementId String?
  createdAt          DateTime @default(now())

  @@index([jobId])
}

model JobLabour {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  staffId   String
  hours     Decimal
  rate      Decimal
  totalCost Decimal
  createdAt DateTime @default(now())

  @@index([jobId])
}

model LedgerEntry {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  type             LedgerEntryType
  amount           Decimal
  currency         String          @default("NGN")
  category         String
  description      String
  linkedRecordType String?
  linkedRecordId   String?
  /** True when this row is an inter-entity transfer (excluded from VAG group P&L). */
  isInternalTransfer Boolean @default(false)
  counterpartyTenantId String?
  invoiceId        String?
  invoice          Invoice?        @relation(fields: [invoiceId], references: [id])
  date             DateTime
  createdAt        DateTime        @default(now())
  deletedAt        DateTime?

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, type])
  @@index([tenantId, type, date])
  @@index([tenantId, isInternalTransfer])
  @@index([invoiceId])
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  email     String?
  phone           String?
  customerGroupId String?
  customerGroup   CustomerGroup? @relation(fields: [customerGroupId], references: [id])
  assignedToUserId String?
  assignedToUser   User?    @relation("CustomerAssignedTo", fields: [assignedToUserId], references: [id])
  openingBalance  Decimal  @default(0)
  totalSell       Decimal  @default(0)
  totalSellDue    Decimal  @default(0)
  totalSellPaid   Decimal  @default(0)
  totalSellReturn Decimal  @default(0)
  totalAdvance    Decimal  @default(0)
  visitCount      Int      @default(0)
  status          String   @default("active")
  /** HQ6 contact tax / VAT registration number. */
  taxNumber       String?
  /**
   * Ultimate POS contact extras: kind, Contact ID, pay term, credit limit,
   * full address, shipping address, custom fields 1–10, etc.
   */
  details         Json?
  createdByUserId String?
  createdByUser   User?    @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  /// Generated FTS — migration `20260812190000_list_search_tsvector` (do not write via Prisma).
  searchVector    Unsupported("tsvector")? @default(dbgenerated("((setweight(to_tsvector('simple'::regconfig, COALESCE(name, ''::text)), 'A'::\"char\") || setweight(to_tsvector('simple'::regconfig, COALESCE(COALESCE(email, ''::text), ''::text)), 'B'::\"char\")) || setweight(to_tsvector('simple'::regconfig, COALESCE(phone, ''::text)), 'B'::\"char\"))"))

  sales        Sale[]
  appointments Appointment[]
  jobs         Job[]
  expensesFor  Expense[] @relation("ExpenseForCustomer")
  expensesContact Expense[] @relation("ExpenseContactCustomer")
  invoices     Invoice[]

  @@index([tenantId])
  @@index([customerGroupId])
  @@index([assignedToUserId])
  @@index([tenantId, status])
  @@index([tenantId, totalSellDue])
  @@index([tenantId, createdAt])
  /// Partial (SQL): Customer_tenantId_name_id_active_idx
  /// ON ("tenantId", name, id) WHERE "deletedAt" IS NULL
}

model TenantDailyFinance {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  date      DateTime @db.Date
  revenue   Decimal  @default(0)
  costs     Decimal  @default(0)
  expenses  Decimal  @default(0)
  net       Decimal  @default(0)
  currency  String   @default("NGN")
  updatedAt DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

model TenantEntitySnapshot {
  tenantId          String   @id
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  archetype         String
  sku               Int      @default(0)
  stockValue        Decimal  @default(0)
  lowStock          Int      @default(0)
  inboundToday      Int      @default(0)
  salesTodayRevenue Decimal  @default(0)
  salesReturns      Int      @default(0)
  activeJobs        Int      @default(0)
  pendingQc         Int      @default(0)
  jobRevenueToday   Decimal  @default(0)
  apptsToday        Int      @default(0)
  apptRevenueToday  Decimal  @default(0)
  retailLowStock    Int      @default(0)
  pendingInbound    Int      @default(0)
  refreshedAt       DateTime @updatedAt
}

model Sale {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  reference     String
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  /** For job-centric tenants (VA), every sale is the commercial record for a job. */
  jobId         String?
  job           Job?           @relation(fields: [jobId], references: [id])
  total         Decimal
  discountAmount Decimal?
  taxAmount      Decimal?
  notes          String?
  currency      String         @default("NGN")
  status        SaleStatus     @default(completed)
  paymentStatus PaymentStatus?
  /** Cached sum of non-return payments (sale + invoice linked). Kept in sync on pay. */
  totalPaid       Decimal        @default(0)
  /** Cached SaleLine count for list pages. */
  itemCount       Int            @default(0)
  locationCode  String?
  paymentMethod   String?
  cleanerUserId   String?
  cleanerUser     User?          @relation("SaleCleaner", fields: [cleanerUserId], references: [id])
  cleanerName     String?
  serviceStaffEmployeeId String?
  serviceStaffEmployee   Employee? @relation("SaleServiceStaff", fields: [serviceStaffEmployeeId], references: [id])
  shippingStatus  String?
  shippingAddress String?
  trackingNumber  String?
  date            DateTime
  createdByUserId String?
  createdByUser   User?          @relation("SaleCreatedBy", fields: [createdByUserId], references: [id])
  createdByName   String?
  createdAt       DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  originalSaleId String?
  originalSale   Sale?  @relation("SaleReturns", fields: [originalSaleId], references: [id])
  returns        Sale[] @relation("SaleReturns")

  lines SaleLine[]
  payments Payment[]
  invoice Invoice?
  storeOrderLinks StoreOrderSale[]

  @@unique([tenantId, reference])
  /// Partial unique (jobId IS NOT NULL) lives in migration `20260717180000_sale_job_link`.
  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, status, date])
  @@index([customerId])
  @@index([jobId])
  @@index([tenantId, shippingStatus])
  @@index([tenantId, paymentMethod])
  @@index([cleanerUserId])
  @@index([tenantId, serviceStaffEmployeeId])
  @@index([originalSaleId])
}

model Discount {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  name         String
  discountType String
  amount       Decimal
  isActive     Boolean   @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantId])
}

model VariationTemplate {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String
  values    String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tenantId])
}

model SaleLine {
  id               String   @id @default(cuid())
  saleId           String
  sale             Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId           String?
  sku              String
  name             String
  quantity         Decimal
  unitPrice        Decimal
  lineTotal        Decimal
  discountAmount   Decimal?
  sourceTenantCode String?
  supplierId       String?
  createdAt        DateTime @default(now())

  @@index([saleId])
  @@index([itemId])
}

model MigrationLegacyId {
  id         String @id @default(cuid())
  tenantId   String
  tenant     Tenant @relation(fields: [tenantId], references: [id])
  entityType String
  legacyId   Int
  newId      String

  @@unique([tenantId, entityType, legacyId])
  @@index([tenantId, entityType])
}

model Notification {
  id               String   @id @default(cuid())
  tenantId         String?
  userId           String?
  type             String
  title            String
  message          String
  severity         String
  linkedRecordType String?
  linkedRecordId   String?
  read             Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([userId, read])
}

model Vehicle {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  plateNumber String
  vin         String?
  make        String
  model       String
  year        Int?
  ownerName   String
  ownerPhone  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([tenantId, plateNumber])
  @@index([tenantId])
}

model Requisition {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  reference String
  status    String    @default("Pending")
  jobId     String?
  locationCode String?
  notes     String?
  /// Source entity tenant id that fulfills the requisition (Warehouse-first).
  sourceTenantId String?
  /// Requested part lines: [{ itemId?, sku, name, quantity }].
  lines     Json?
  fulfilledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([tenantId, reference])
  @@index([tenantId])
