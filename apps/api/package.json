{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "npm run build --workspace=@vonos/types",
    "build": "prisma generate && nest build",
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "start:railway": "bash scripts/railway-start.sh",
    "migrate:deploy": "prisma migrate deploy",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "prisma:merge-va": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/scripts/merge-vm-vms-into-va.ts",
    "prisma:dedupe-suppliers": "tsx prisma/scripts/dedupe-suppliers.ts",
    "prisma:soft-delete-bad-prices": "tsx prisma/scripts/soft-delete-bad-profit-percent-prices.ts",
    "prisma:backfill-location-stock": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/scripts/backfill-item-location-stock.ts",
    "prisma:backfill-job-customer-id": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/scripts/backfill-job-customer-id.ts",
    "prisma:backfill-job-vehicles": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/scripts/backfill-job-vehicles.ts",
    "prisma:backfill-employees-from-payroll": "ts-node --transpile-only prisma/scripts/backfill-employees-from-payroll.ts",
    "prisma:mark-service-staff": "ts-node --transpile-only prisma/scripts/mark-service-staff-from-designations.ts",
    "prisma:assign-service-staff": "ts-node --transpile-only prisma/scripts/assign-service-staff-from-payroll-groups.ts",
    "prisma:backfill-sale-service-staff": "ts-node --transpile-only prisma/scripts/backfill-sale-service-staff-from-legacy.ts",
    "prisma:va-finance-spotcheck": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/scripts/sql-va-finance-spotcheck.ts",
    "prisma:explain-va-lists": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/scripts/explain-va-lists.ts",
    "prisma:backfill-daily-finance": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/scripts/backfill-daily-finance.ts",
    "prisma:refresh-entity-snapshots": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/scripts/refresh-entity-snapshots.ts",
    "prisma:sync-product-stock-locations": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/scripts/sync-product-stock-locations.ts",
    "prisma:seed-designations": "ts-node --transpile-only prisma/scripts/seed-designations-va.ts",
    "prisma:seed-expense-categories": "ts-node --transpile-only prisma/scripts/seed-expense-categories.ts",
    "prisma:clone-va-master-data": "ts-node --transpile-only prisma/scripts/clone-va-master-data.ts",
    "prisma:sync-group-master-data": "ts-node --transpile-only prisma/scripts/sync-group-master-data.ts",
    "prisma:sync-group-service-staff": "ts-node --transpile-only prisma/scripts/sync-group-service-staff.ts",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.11.1",
    "@upstash/redis": "^1.38.0",
    "@vonos/types": "*",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "multer": "^2.1.1",
    "otplib": "^13.4.1",
    "prisma": "^6.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vercel/node": "^5.3.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/\\.publish/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/../../.publish/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
